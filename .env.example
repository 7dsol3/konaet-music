# Variables are read from the environment; this file is documentation, not auto-loaded.
EMPORIO_PROVIDER=local
# Optional native function-calling backend. No remote provider is enabled by default.
# EMPORIO_PROVIDER=openai_compatible
# EMPORIO_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# EMPORIO_MODEL=your-installed-model
# EMPORIO_MODEL_KEY=
# EMPORIO_MODEL_TIMEOUT=15
# Override for public demo hosting; must be the trusted HTTPS origin.
# KONAET_PUBLIC_URL=https://your-music-demo.example
# EMPORIO_STATE_DIR=/path/to/writable/private/state
# Optional verified local model cache:
# KONAET_MODEL_CACHE=/path/to/model/cache
# Payment collection is intentionally unavailable. No payment key is needed.
